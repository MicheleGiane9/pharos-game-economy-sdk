{
  "name": "pharos-game-economy-sdk",
  "version": "1.0.0",
  "description": "Complete Web3 game economy SDK for Pharos Network",
  "main": "dist/index.js",
  "bin": {
    "pharos-economy": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc --project tsconfig.json",
    "dev": "ts-node src/index.ts",
    "compile": "hardhat compile",
    "test": "hardhat test",
    "test:coverage": "hardhat coverage",
    "deploy:local": "hardhat run scripts/deploy.ts --network hardhat",
    "deploy:testnet": "hardhat run scripts/deploy.ts --network pharosTestnet",
    "deploy:mainnet": "hardhat run scripts/deploy.ts --network pharosMainnet",
    "verify:testnet": "hardhat run scripts/verify.ts --network pharosTestnet",
    "verify:mainnet": "hardhat run scripts/verify.ts --network pharosMainnet",
    "lint": "eslint src --ext .ts",
    "clean": "hardhat clean && rimraf dist"
  },
  "dependencies": {
    "@openzeppelin/contracts": "^5.0.2",
    "chalk": "^5.3.0",
    "commander": "^12.1.0",
    "dotenv": "^16.4.5",
    "ethers": "^6.13.1",
    "inquirer": "^10.1.8",
    "ora": "^8.0.1",
    "fs-extra": "^11.2.0",
    "handlebars": "^4.7.8"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-chai-matchers": "^2.0.7",
    "@nomicfoundation/hardhat-ethers": "^3.0.6",
    "@nomicfoundation/hardhat-ignition": "^0.15.5",
    "@nomicfoundation/hardhat-ignition-ethers": "^0.15.5",
    "@nomicfoundation/hardhat-network-helpers": "^1.0.11",
    "@nomicfoundation/hardhat-toolbox": "^5.0.0",
    "@nomicfoundation/hardhat-verify": "^2.0.9",
    "@typechain/ethers-v6": "^0.5.1",
    "@typechain/hardhat": "^9.1.0",
    "@types/chai": "^4.3.16",
    "@types/fs-extra": "^11.0.4",
    "@types/inquirer": "^9.0.7",
    "@types/mocha": "^10.0.7",
    "@types/node": "^20.14.11",
    "chai": "^4.4.1",
    "hardhat": "^2.22.7",
    "hardhat-gas-reporter": "^1.0.10",
    "mocha": "^10.6.0",
    "rimraf": "^5.0.9",
    "solidity-coverage": "^0.8.12",
    "ts-node": "^10.9.2",
    "typechain": "^8.3.2",
    "typescript": "^5.5.3"
  },
  "keywords": [
    "pharos",
    "web3",
    "gaming",
    "economy",
    "erc20",
    "blockchain",
    "rewards",
    "defi"
  ],
  "author": "Pharos Network",
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  },
  "files": [
    "dist/",
    "contracts/",
    "skill.yaml",
    "README.md"
  ]
}
