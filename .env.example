# Deployer private key — NEVER commit your real key
PRIVATE_KEY=0xabc123...

# Pharos Network RPC endpoints
PHAROS_TESTNET_RPC=https://atlantic.dplabs-internal.com
PHAROS_MAINNET_RPC=https://rpc.pharos.xyz

# Block explorer API key for contract verification
PHAROSSCAN_API_KEY=your_api_key_here

# WalletConnect Project ID (get from https://cloud.walletconnect.com)
VITE_WALLETCONNECT_PROJECT_ID=your_project_id_here

# Deployed contract addresses (populated after running deploy scripts)
VITE_GAME_REWARD_TOKEN_ADDRESS=
VITE_REWARD_ENGINE_ADDRESS=
VITE_CHAIN_ID=688689

# Gas reporting (set to "true" to enable)
REPORT_GAS=false
